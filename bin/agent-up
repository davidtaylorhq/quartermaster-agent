#!/bin/bash
# The model client has its own filesystem and reaches the work tree through MCP.
set -Eeuo pipefail

: "${RUNNER_TEMP:?}" "${BRIDGE_IP:?}" "${SSH_PORT:?}"
: "${CLIENT_KEY:?}" "${AGENT_DIR:?}" "${GATE_USER:?}" "${SANDBOX_IMAGE:?}"

CONTAINER=workflow-agent-client
HOME_DIR=/home/agent

log() { echo "[agent] $*" >&2; }

CONFIG_DIR="$RUNNER_TEMP/agent-config"
OUTPUT_DIR="$RUNNER_TEMP/output"
AGENT_TMP="$CONFIG_DIR/agents/workflow-agent"
mkdir -p "$CONFIG_DIR/agents"
cp -r "$AGENT_DIR" "$AGENT_TMP"
cp -r "$AGENT_DIR/skills" "$CONFIG_DIR/skills"
if [ "$(jq 'length' "$ENVIRONMENTS_JSON")" != 0 ]; then
  {
    echo
    echo "## Development environments"
    echo
    echo "Through the workspace shell, run commands in one of these environments:"
    echo
    jq -r 'to_entries[] | "    \(.key) — \(.value.description)"' "$ENVIRONMENTS_JSON"
    echo
    echo "Name the environment before the command:"
    echo
    jq -r 'to_entries[0] | "    dev \(.key) <command>"' "$ENVIRONMENTS_JSON"
    echo
    echo "The workspace has git and little else. Commands needing a runtime run in an environment, at its mount point."
    echo "The first command into an environment takes a few minutes while it starts; afterwards they are quick. Do not start one you have nothing to run in."
  } >> "$AGENT_TMP/system.md"
fi
sed -e "s#__KEY__#$HOME_DIR/.ssh/gate#" \
    -e "s#__SSH_PORT__#$SSH_PORT#" \
    -e "s#__GATE_USER__#$GATE_USER#" \
    "$AGENT_DIR/mcp.json" \
  | jq --slurpfile workspace "$RUNNER_TEMP/workspace-mcp.json" \
    '.servers.workspace = $workspace[0]' > "$CONFIG_DIR/mcp.json"
chmod 640 "$CONFIG_DIR/mcp.json"
if [ -n "${TERM_LLM_CONFIG:-}" ] && [ -s "$TERM_LLM_CONFIG" ]; then
  cp "$TERM_LLM_CONFIG" "$CONFIG_DIR/config.yaml"
fi
sudo chown -R 1000:"$(id -g)" "$CONFIG_DIR"
sudo install -d -o 1000 -g "$(id -g)" -m 2770 "$OUTPUT_DIR"

log "booting $SANDBOX_IMAGE"
docker run -d \
  --name "$CONTAINER" \
  --add-host "host.docker.internal:$BRIDGE_IP" \
  -v "$CONFIG_DIR:$HOME_DIR/.config/term-llm:ro" \
  -v "$CLIENT_KEY:$HOME_DIR/.ssh/gate:ro" \
  -v "$OUTPUT_DIR:/output:rw" \
  -e OUTPUT_DIR=/output \
  "$SANDBOX_IMAGE" >/dev/null

jq -n --arg container "$CONTAINER" --arg home "$HOME_DIR" \
  '{container: $container, home: $home}' > "$RUNNER_TEMP/agent.json"
log "agent ready"
