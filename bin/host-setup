#!/bin/bash
# Stand up the GitHub services the containers are allowed to reach.
set -euo pipefail

step() { echo "[host] $*" >&2; }

: "${RUNNER_TEMP:?}" "${HEAD_REF:?}" "${GITHUB_REPOSITORY:?}"
: "${GH_TOKEN:?}"

STATE="$HOME/.workflow-agent"
RELAY="$RUNNER_TEMP/relay.git"
PUSHED="$RUNNER_TEMP/relay.pushed"
SSH_PORT=2222
FORWARD_PORT=2223
MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.12.2
WORKTREE=$RUNNER_TEMP/worktree

step "preparing $STATE"

# While the sandbox is being built, rather than on first use.
nohup docker pull -q "$MCP_IMAGE" > "$RUNNER_TEMP/mcp-pull.log" 2>&1 &
mkdir -p "$STATE"
chmod 700 "$STATE"

step "finding the docker bridge"
bridge=$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
: "${bridge:=172.17.0.1}"

step "building the relay on $bridge"
# ---------------------------------------------------------------- git relay
git --git-dir="$RELAY" config core.bare true
git --git-dir="$RELAY" symbolic-ref HEAD "refs/heads/$HEAD_REF"
# What the push leases against. The relay is a copy of the work tree, so this
# is the commit the agent started from.
git --git-dir="$RELAY" rev-parse "refs/heads/$HEAD_REF" > "$PUSHED"

# A branch name may hold a backtick, a dollar or a quote, and a shell on the
# runner reads all of this, so every value is quoted.
step "writing the gate environment"
: > "$STATE/env"
chmod 600 "$STATE/env"
put() { printf 'export %s=%q\n' "$1" "$2" >> "$STATE/env"; }
put RELAY "$RELAY"
put PUSHED "$PUSHED"
put BOT_NAME "$BOT_NAME"
put HEAD_REF "$HEAD_REF"
put MCP_IMAGE "$MCP_IMAGE"
put GITHUB_PERSONAL_ACCESS_TOKEN "$GH_TOKEN"
put GH_TOKEN "$GH_TOKEN"
put GITHUB_TOOLSETS "${GITHUB_TOOLSETS:-pull_requests,issues}"
put GITHUB_READ_ONLY 1
put WORKTREE "$WORKTREE"
put PROGRESS "$PROGRESS_SCRIPT"
put ENVIRONMENTS "$STATE/environments.json"
put ASSET_REPO "$ASSET_REPO"
put ASSET_REF "$ASSET_REF"
put COMMENT_ID "${COMMENT_ID:-}"
put GITHUB_REPOSITORY "$GITHUB_REPOSITORY"
put RUN_URL "${RUN_URL:-}"
put RUNNER_TEMP "$RUNNER_TEMP"
put CAN_PUSH "${CAN_PUSH:-false}"
put PUSH_BLOCKED_BECAUSE "${PUSH_BLOCKED_BECAUSE:-}"

cat > "$RELAY/hooks/update" <<'HOOK'
#!/bin/bash
. "$HOME/.workflow-agent/env"
if [ "$1" != "refs/heads/$HEAD_REF" ]; then
  echo "${BOT_NAME}: only $HEAD_REF may be pushed from the sandbox" >&2
  exit 1
fi
HOOK

# Git ignores what post-receive exits with, so a failed forward must say so.
cat > "$RELAY/hooks/post-receive" <<'HOOK'
#!/bin/bash
. "$HOME/.workflow-agent/env"
while read -r old new ref; do
  [ "$ref" = "refs/heads/$HEAD_REF" ] || continue

  if [ "${CAN_PUSH:-false}" != true ]; then
    echo "${BOT_NAME}: kept in the sandbox, not sent to GitHub: ${PUSH_BLOCKED_BECAUSE:-pushing is unavailable}"
    continue
  fi

  expected=$(cat "$PUSHED")
  auth=$(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)
  if git -c http.extraheader="AUTHORIZATION: basic $auth" \
       push --force-with-lease="refs/heads/$HEAD_REF:$expected" \
       "https://github.com/$GITHUB_REPOSITORY.git" \
       "$new:refs/heads/$HEAD_REF" 2>&1
  then
    printf '%s' "$new" > "$PUSHED"
    echo "${BOT_NAME}: pushed ${new:0:12} to $HEAD_REF on GitHub"
  else
    # Put the relay back, or the next push of the same commit is a no-op
    # against a ref that already moved, and nothing reaches GitHub at all.
    git update-ref "$ref" "$old"
    echo "${BOT_NAME}: GitHub refused the push; the commit is only in the sandbox"
    echo "${BOT_NAME}: the branch most likely moved since this run started"
    echo "${BOT_NAME}: push again to try it again"
  fi
done
HOOK
chmod +x "$RELAY/hooks/update" "$RELAY/hooks/post-receive"

install -m 0755 "$(dirname "$0")/host-gate"  "$STATE/gate"
install -m 0755 "$(dirname "$0")/dev-boot"   "$STATE/dev-boot"
install -m 0644 "$ENVIRONMENTS_JSON" "$STATE/environments.json"

# ------------------------------------------------------- the read-only path
# The sandbox has no credential, so its reads of this repository come through
# here, and nothing else does.
step "forwarding reads to GitHub on $bridge:$FORWARD_PORT"
nohup "$FORWARD_SCRIPT" "$bridge" "$FORWARD_PORT" > "$RUNNER_TEMP/forward.log" 2>&1 &

# --------------------------------------------------------------- the ssh gate
step "generating keys"
ssh-keygen -q -t ed25519 -N '' -f "$STATE/hostkey"
ssh-keygen -q -t ed25519 -N '' -f "$STATE/clientkey" -C "$BOT_NAME"
# The default location: sshd ignores an AuthorizedKeysFile elsewhere in
# silence, which looks exactly like a wrong key.
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
printf 'restrict,command="%s/gate" %s\n' "$STATE" "$(cat "$STATE/clientkey.pub")" \
  >> "$HOME/.ssh/authorized_keys"
chmod 600 "$HOME/.ssh/authorized_keys"

cat > "$STATE/sshd_config" <<CONF
Port $SSH_PORT
ListenAddress $bridge
HostKey $STATE/hostkey
AllowUsers $(id -un)
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
# The runner account has no password, which sshd reads as locked without PAM.
UsePAM yes
PrintMotd no
LogLevel VERBOSE
# The runner's home is group-writable, which sshd silently refuses to trust.
StrictModes no
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
Subsystem sftp /bin/false
CONF

step "starting sshd"
sudo mkdir -p /run/sshd
sudo touch "$RUNNER_TEMP/sshd.log"
sudo chmod 666 "$RUNNER_TEMP/sshd.log"
if ! sudo /usr/sbin/sshd -f "$STATE/sshd_config" -E "$RUNNER_TEMP/sshd.log"; then
  echo "[host] sshd refused to start:" >&2
  sudo cat "$RUNNER_TEMP/sshd.log" >&2 || true
  sudo /usr/sbin/sshd -T -f "$STATE/sshd_config" >&2 || true
  exit 1
fi

sudo install -o 1000 -m 0400 "$STATE/clientkey" "$RUNNER_TEMP/gate-key"

step "gate is listening on:"
ss -tln | grep ":$SSH_PORT" >&2 || echo "[host] nothing on $SSH_PORT" >&2

{
  echo "BRIDGE_IP=$bridge"
  echo "SSH_PORT=$SSH_PORT"
  echo "FORWARD_PORT=$FORWARD_PORT"
  echo "CLIENT_KEY=$RUNNER_TEMP/gate-key"
  echo "GATE_USER=$(id -un)"
  echo "WORKTREE=$WORKTREE"
} >> "$GITHUB_ENV"

echo "gate on $bridge:$SSH_PORT"
