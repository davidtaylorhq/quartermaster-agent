#!/bin/bash
# Send a command to a declared development environment through the SSH gate.
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo 'usage: dev <environment> <command>...' >&2
  exit 2
fi
: "${SSH_PORT:?}" "${GATE_USER:?}"

name=$1
shift
{ printf '%q ' "$@"; printf '\n'; } |
  ssh -T -i "$HOME/.ssh/gate" -p "$SSH_PORT" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    "$GATE_USER@host.docker.internal" "dev $name"
