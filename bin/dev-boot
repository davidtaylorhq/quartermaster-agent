#!/bin/bash
# Start one of the project's development environments, once. The project says
# what to run; the flags that keep the sandbox shut are set here.
set -euo pipefail

. "$HOME/.workflow-agent/env"

NAME="$1"
LOG="${RUNNER_TEMP:-/tmp}/dev-up.log"
CONTAINER="workflow-agent-dev-$NAME"
USABLE="${RUNNER_TEMP:-/tmp}/dev-$NAME.usable"

# This runs behind the gate, so anything printed here would land in the middle
# of the output the agent asked for.
note() { echo "[$NAME] $*" >> "$LOG"; }
fatal() { note "$*"; echo "$BOT_NAME: $NAME: $*" >&2; exit 1; }
progress() {
  if ! flock "${RUNNER_TEMP:-/tmp}/progress.lock" "$PROGRESS" "$@" >>"$LOG" 2>&1; then
    echo "[$NAME] progress $* failed" >> "$LOG"
  fi
}

field() { jq -r --arg n "$NAME" --arg f "$1" '.[$n][$f] // ""' "$ENVIRONMENTS"; }

# One environment prepares at a time: the checklist is a single line and
# cannot say that two of them are starting at once.
exec 9>"${RUNNER_TEMP:-/tmp}/dev-boot.lock"
flock 9

# Made once and set up once: a second container over the first one's volumes
# would run setup against a state it was told it would not see.
status=none
if found=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null); then
  status=$(printf '%s' "$found" | tr -d '[:space:]')
  [ -n "$status" ] || status=none
fi

case "$status" in
  running)
    [ -f "$USABLE" ] || fatal "initialization did not establish a usable environment"
    exit 0 ;;
  none)    ;;
  *)       fatal "the environment $status and will not be started again" ;;
esac

progress interrupt "Preparing $NAME"
trap 'progress resume' EXIT

IMAGE=$(field image)
MOUNT=$(field mount)
USER_NAME=$(field user)
ENTRYPOINT=$(field entrypoint)
mapfile -t CMD < <(jq -r --arg n "$NAME" '.[$n].cmd[]?' "$ENVIRONMENTS")
SETUP=$(field setup)

note "starting $IMAGE"
args=(run -d --name "$CONTAINER" -v "$WORKTREE:$MOUNT" -w "$MOUNT")
[ -n "$ENTRYPOINT" ] && args+=(--entrypoint "$ENTRYPOINT")
args+=("$IMAGE")
args+=("${CMD[@]}")
if ! docker "${args[@]}" >>"$LOG" 2>&1; then
  fatal "the container would not start"
fi

# The sandbox writes the work tree as uid 1000; this side must match.
if [ -n "$USER_NAME" ]; then
  docker exec -u root "$CONTAINER" sh -c '
    set -e
    [ "$(id -u "$1")" = 1000 ] || {
      usermod -u 1000 "$1"
      groupmod -g 1000 "$1" 2>/dev/null || true
      chown -R 1000:1000 "$(getent passwd "$1" | cut -d: -f6)"
    }
  ' sh "$USER_NAME" >>"$LOG" 2>&1 || fatal "could not give $USER_NAME uid 1000"
fi

# A failed project setup can still be inspected, once the user is usable.
touch "$USABLE"

if [ -n "$SETUP" ]; then
  note "setting up"
  if ! docker exec -i ${USER_NAME:+-u "$USER_NAME"} -w "$MOUNT" -e CI=1 \
       "$CONTAINER" bash -e -o pipefail -lc "$SETUP" </dev/null >>"$LOG" 2>&1; then
    fatal "setup failed, and the log has why"
  fi
fi

note "ready"
