#!/bin/bash
set -euo pipefail

request=$(cat)
if ! jq -e '
  type == "object" and
  (.command | type == "string" and length > 0 and (contains("\u0000") | not)) and
  ((.working_dir // "/src") | type == "string" and (contains("\u0000") | not)) and
  ((.timeout_seconds // 600) | type == "number" and . >= 1 and . <= 600 and . == floor)
' >/dev/null <<< "$request"; then
  echo 'workspace_shell: expected a command, working directory, and integer timeout of 1–600 seconds' >&2
  exit 2
fi

mapfile -d '' -t fields < <(jq -j '
  .command, "\u0000", (.working_dir // "/src"), "\u0000",
  ((.timeout_seconds // 600) | tostring), "\u0000"
' <<< "$request")
cd -- "${fields[1]}"
# Enforce the deadline here even if the SSH client disconnects.
exec timeout --kill-after=5s "${fields[2]}s" bash --noprofile --norc -c "${fields[0]}"
