#!/bin/sh
# The only things the sandbox can ask the runner to do. Reading this repository
# is not one of them: that goes to the forwarder over HTTP.
#
# A forced command in authorized_keys: it matches the verb and supplies its own
# arguments, discarding the client's.
. "$HOME/.workflow-agent/env"

case "$SSH_ORIGINAL_COMMAND" in
  mcp)
    exec docker run -i --rm \
      -e GITHUB_PERSONAL_ACCESS_TOKEN \
      -e GITHUB_TOOLSETS \
      -e GITHUB_READ_ONLY \
      "$MCP_IMAGE"
    ;;
  "dev "*)
    # The name is looked up, never interpreted.
    name=${SSH_ORIGINAL_COMMAND#dev }
    if ! jq -e --arg n "$name" 'has($n)' "$ENVIRONMENTS" >/dev/null 2>&1; then
      echo "$BOT_NAME: no environment called '$name'" >&2
      echo "$BOT_NAME: this project has: $(jq -r 'keys | join(", ")' "$ENVIRONMENTS")" >&2
      exit 1
    fi

    # stdin is the agent's command; the boot must not consume it.
    "$HOME/.workflow-agent/dev-boot" "$name" </dev/null || exit 1

    user=$(jq -r --arg n "$name" '.[$n].user // ""' "$ENVIRONMENTS")
    mount=$(jq -r --arg n "$name" '.[$n].mount' "$ENVIRONMENTS")
    if [ -n "$user" ]; then
      exec docker exec -i -u "$user" -w "$mount" -e CI=1 "workflow-agent-dev-$name" bash -l
    fi
    exec docker exec -i -w "$mount" -e CI=1 "workflow-agent-dev-$name" bash -l
    ;;
  git-receive-pack*)
    exec git-receive-pack "$RELAY"
    ;;
  *)
    echo "$BOT_NAME: not permitted" >&2
    exit 1
    ;;
esac
