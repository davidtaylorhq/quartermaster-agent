#!/bin/bash
# Build the sandbox the agent works in: git, ssh and term-llm. The work tree is
# already there, and the development environment mounts the same directory.
set -Eeuo pipefail

: "${RUNNER_TEMP:?}" "${BRIDGE_IP:?}" "${SSH_PORT:?}"
: "${CLIENT_KEY:?}" "${AGENT_DIR:?}"
: "${GATE_USER:?}" "${SANDBOX_IMAGE:?}" "${WORKTREE:?}"
: "${FORWARD_PORT:?}" "${GITHUB_REPOSITORY:?}" "${MODEL_PORT:?}"


CONTAINER=workflow-agent-sandbox
SKILLS_DIR="$AGENT_DIR/skills"
MCP_TEMPLATE="$AGENT_DIR/mcp.json"
HOME_DIR=/home/agent
SSH_OPTS="-i $HOME_DIR/.ssh/gate -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

log() { echo "[sandbox] $*" >&2; }

dump_host_log() {
  echo "[sandbox] --- sshd log ---" >&2
  sudo cat "$RUNNER_TEMP/sshd.log" 2>/dev/null >&2 || true
}
trap dump_host_log ERR

in_sandbox() {
  docker exec -u agent -w /src -e HOME="$HOME_DIR" "$CONTAINER" "$@"
}

# A provider reached by running a command speaks to the runner instead, which
# holds its credential. Reads of the repository stay on plain http, so only
# https is sent that way.
tunnel=()
if [ -n "${MODEL_TUNNEL_HOSTS:-}" ]; then
  tunnel=(
    -e "HTTPS_PROXY=http://host.docker.internal:$MODEL_PORT"
    -e "https_proxy=http://host.docker.internal:$MODEL_PORT"
    -e "NO_PROXY=localhost,127.0.0.1,host.docker.internal"
    -e "no_proxy=localhost,127.0.0.1,host.docker.internal"
    -e "SSL_CERT_FILE=/usr/local/share/qm-bundle.crt"
    -e "NODE_EXTRA_CA_CERTS=/usr/local/share/qm-ca.crt"
  )
fi

log "booting $SANDBOX_IMAGE"
docker run -d \
  --name "$CONTAINER" \
  --add-host "host.docker.internal:$BRIDGE_IP" \
  -v "$WORKTREE:/src" \
  "${tunnel[@]}" \
  "$SANDBOX_IMAGE" >/dev/null

if [ -n "${MODEL_TUNNEL_HOSTS:-}" ]; then
  log "trusting the runner for $MODEL_TUNNEL_HOSTS"
  docker cp "$MODEL_CA" "$CONTAINER:/usr/local/share/qm-ca.crt"
  docker exec -u root "$CONTAINER" bash -c \
    'cat /etc/ssl/certs/ca-certificates.crt /usr/local/share/qm-ca.crt \
       > /usr/local/share/qm-bundle.crt'
fi

docker exec -u root -e STRIP="${PROVIDER_ENV_NAMES:-}" "$CONTAINER" bash -c '
  {
    echo "#!/bin/sh"
    printf "exec env"
    for name in $STRIP; do printf " -u %s" "$name"; done
    echo " /bin/bash \"\$@\""
  } > /usr/local/bin/qm-shell
  chmod 0755 /usr/local/bin/qm-shell
'
docker cp "$CLIENT_KEY" "$CONTAINER:$HOME_DIR/.ssh/gate"
docker exec -u root "$CONTAINER" chown agent:agent "$HOME_DIR/.ssh/gate"
docker exec -u root "$CONTAINER" chmod 600 "$HOME_DIR/.ssh/gate"

# Anything needing more than git runs in a named development environment.
if [ "$(jq 'length' "$ENVIRONMENTS_JSON")" != 0 ]; then
  log "installing the development environment wrapper"
  docker exec -u root "$CONTAINER" bash -c "
    set -e
    cat > /usr/local/bin/dev <<'WRAP'
#!/bin/bash
# Run a command in one of this project's development environments.
set -euo pipefail
if [ \$# -lt 2 ]; then
  echo 'usage: dev <environment> <command>...' >&2
  exit 2
fi
name=\$1
shift
{ printf '%q ' \"\$@\"; printf '\n'; } > /tmp/dev.\$\$
exec ssh $SSH_OPTS $GATE_USER@host.docker.internal \"dev \$name\" < /tmp/dev.\$\$
WRAP
    chmod 0755 /usr/local/bin/dev
  "
fi

# Reads go through the forwarder, which holds the credential the sandbox must
# not. Pushes go through the gate, whose hooks decide what reaches the branch.
log "pointing the work tree at the gate"
in_sandbox git remote set-url origin \
  "http://host.docker.internal:$FORWARD_PORT/$GITHUB_REPOSITORY.git"
in_sandbox git remote set-url --push origin \
  "ssh://$GATE_USER@host.docker.internal/relay.git"

log "installing the agent"
docker exec -u root "$CONTAINER" install -d -o agent -g agent \
  "$HOME_DIR/.config/term-llm/agents" "$HOME_DIR/.config/term-llm/skills"
AGENT_TMP="$RUNNER_TEMP/agent"
rm -rf "$AGENT_TMP"
cp -r "$AGENT_DIR" "$AGENT_TMP"
if [ "$(jq 'length' "$ENVIRONMENTS_JSON")" != 0 ]; then
  {
    echo
    echo "## Development environments"
    echo
    echo "Commands needing more than git run in one of these:"
    echo
    jq -r 'to_entries[] | "    \(.key) — \(.value.description)"' "$ENVIRONMENTS_JSON"
    echo
    echo "Name the one you want:"
    echo
    jq -r 'to_entries[0] | "    dev \(.key) <command>"' "$ENVIRONMENTS_JSON"
    echo
    echo "Nothing runs in the sandbox itself, so a command on its own fails: there is no runtime for it there. Commands run at the environment's mount point."
    echo
    echo "The first command into an environment takes a few minutes while it starts; afterwards they are quick. Do not start one you have nothing to run in."
  } >> "$AGENT_TMP/system.md"
fi
docker cp "$AGENT_TMP/." "$CONTAINER:$HOME_DIR/.config/term-llm/agents/workflow-agent"
docker cp "$SKILLS_DIR/." "$CONTAINER:$HOME_DIR/.config/term-llm/skills"
sed -e "s#__KEY__#$HOME_DIR/.ssh/gate#" \
    -e "s#__SSH_PORT__#$SSH_PORT#" \
    -e "s#__GATE_USER__#$GATE_USER#" \
    "$MCP_TEMPLATE" > "$RUNNER_TEMP/mcp.json"
docker cp "$RUNNER_TEMP/mcp.json" "$CONTAINER:$HOME_DIR/.config/term-llm/mcp.json"
if [ -n "${TERM_LLM_CONFIG:-}" ] && [ -s "$TERM_LLM_CONFIG" ]; then
  log "installing the project's term-llm configuration"
  docker cp "$TERM_LLM_CONFIG" "$CONTAINER:$HOME_DIR/.config/term-llm/config.yaml"
fi

docker exec -u root "$CONTAINER" chown -R agent:agent "$HOME_DIR/.config"

# The sandbox holds a placeholder, so its model requests have to come back
# past the runner for the real key to be put in.
for slot in ${MODEL_BEHIND_PROXY:-}; do
  log "pointing $slot at the model proxy"
  in_sandbox "$HOME_DIR/.local/bin/term-llm" config set \
    "providers.$slot.base_url" "http://host.docker.internal:$MODEL_PORT/$slot"
done

log "sandbox ready"
cat > "$RUNNER_TEMP/sandbox.json" <<JSON
{
  "container": "$CONTAINER",
  "home": "$HOME_DIR",
  "sshOptions": "$SSH_OPTS"
}
JSON
