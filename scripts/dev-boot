#!/bin/bash
# Start one of the project's development environments, once.
#
# Called by the gate with the environment's name. Everything the project said
# about it is in the environments file; everything about how a container is
# run is here, so no project can choose the flags that hold the sandbox shut.
set -euo pipefail

. "$HOME/.quartermaster/env"

NAME="$1"
LOG="${RUNNER_TEMP:-/tmp}/dev-up.log"
CONTAINER="quartermaster_dev_$NAME"

# Everything here runs behind the gate, so anything written to the agent's
# connection lands in the middle of whatever it asked for: the first command
# after a boot came back with pages of install output wrapped around its own,
# and the agent ran it again to see it cleanly. All of it goes to the log the
# runner follows instead.
note() { echo "[$NAME] $*" >> "$LOG"; }
# What goes wrong has to reach the agent. Everything else stays in the log:
# the agent asked for one command, and should not be read pages of another.
fatal() { note "$*"; echo "$BOT_NAME: $NAME: $*" >&2; exit 1; }
progress() {
  if ! "$PROGRESS" "$@" >>"$LOG" 2>&1; then
    echo "[$NAME] progress $* failed" >> "$LOG"
  fi
}

field() { jq -r --arg n "$NAME" --arg f "$1" '.[$n][$f] // ""' "$ENVIRONMENTS"; }

exec 9>"${RUNNER_TEMP:-/tmp}/dev-$NAME.lock"
flock 9

# A container is made once and set up once. One that has gone away stays gone:
# starting a second over volumes the first already wrote to would run setup
# against a state it was promised it would never see.
# Only a successful inspect says anything about the container. Reading the
# failure's output instead trusts docker to print nothing when it cannot find
# one, and it does not.
status=none
if found=$(docker inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null); then
  status=$(printf '%s' "$found" | tr -d '[:space:]')
  [ -n "$status" ] || status=none
fi

case "$status" in
  running) exit 0 ;;
  none)    ;;
  *)       fatal "the environment $status and will not be started again" ;;
esac

# The agent got as far as needing this, so that stretch of work is finished.
# What follows is the wait, and then the rest of the work under its own name.
progress next "Preparing $NAME" "Working in $NAME"

IMAGE=$(field image)
MOUNT=$(field mount)
USER_NAME=$(field user)
ENTRYPOINT=$(field entrypoint)
CMD=$(field cmd)
SETUP=$(field setup)

note "starting $IMAGE"
args=(run -d --name "$CONTAINER" -v "$WORKTREE_VOLUME:$MOUNT" -w "$MOUNT")
[ -n "$ENTRYPOINT" ] && args+=(--entrypoint "$ENTRYPOINT")
args+=("$IMAGE")
[ -n "$CMD" ] && args+=("$CMD")
if ! docker "${args[@]}" >>"$LOG" 2>&1; then
  fatal "the container would not start"
fi

# The sandbox writes the work tree as uid 1000, so whoever runs commands here
# has to be uid 1000 too, or neither side can read what the other wrote.
if [ -n "$USER_NAME" ]; then
  docker exec -u root "$CONTAINER" sh -c '
    set -e
    [ "$(id -u "$1")" = 1000 ] || {
      usermod -u 1000 "$1"
      groupmod -g 1000 "$1" 2>/dev/null || true
      chown -R 1000:1000 "$(getent passwd "$1" | cut -d: -f6)"
    }
  ' sh "$USER_NAME" >>"$LOG" 2>&1 || fatal "could not give $USER_NAME uid 1000"
fi

if [ -n "$SETUP" ]; then
  note "setting up"
  if ! docker exec -i ${USER_NAME:+-u "$USER_NAME"} -w "$MOUNT" -e CI=1 \
       "$CONTAINER" bash -lc "$SETUP" </dev/null >>"$LOG" 2>&1; then
    fatal "setup failed, and the log has why"
  fi
fi

progress next
note "ready"
