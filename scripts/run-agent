#!/bin/bash
# Boot the sandbox and run the agent in it.
#
# The sandbox is deliberately small: git, ssh and term-llm. It holds no
# credentials and mounts nothing from the runner. The work tree is a docker
# volume, which the development environment mounts too if the agent ever needs
# one, so a run that only answers a question never waits for it.
set -Eeuo pipefail

: "${RUNNER_TEMP:?}" "${BRIDGE_IP:?}" "${SSH_PORT:?}"
: "${CLIENT_KEY:?}" "${HEAD_REF:?}" "${AGENT_DIR:?}"
: "${GATE_USER:?}" "${SKILLS_DIR:?}" "${TERM_LLM_VERSION:?}" "${WORKTREE_VOLUME:?}"
: "${MCP_TEMPLATE:?}"

CONTAINER=quartermaster_sandbox
IMAGE=debian:stable-slim
HOME_DIR=/home/agent
SSH_OPTS="-i $HOME_DIR/.ssh/gate -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

log() { echo "[sandbox] $*" >&2; }

# The model's credentials have to be in term-llm's environment, because a
# provider that shells out reads them from there. Nothing the agent runs has
# any use for them, and term-llm starts every shell tool call with $SHELL, so
# a shell of our own takes them back out again.
creds=()
if [ -n "${PROVIDER_ENV_FILE:-}" ] && [ -s "$PROVIDER_ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$PROVIDER_ENV_FILE"
  set +a
  for name in $PROVIDER_ENV_NAMES; do creds+=(-e "$name"); done
fi

dump_host_log() {
  echo "[sandbox] --- sshd log ---" >&2
  sudo cat "$RUNNER_TEMP/sshd.log" 2>/dev/null >&2 || true
}
trap dump_host_log ERR

as_agent() {
  docker exec -i -u agent -w /src \
    -e HOME="$HOME_DIR" \
    -e GIT_SSH_COMMAND="ssh $SSH_OPTS" \
    -e HEAD_REF="$HEAD_REF" \
    -e SHELL=/usr/local/bin/qm-shell \
    "${creds[@]}" \
    "$CONTAINER" bash -lc 'export PATH="$HOME/.local/bin:$PATH"; '"$1"
}

log "booting $IMAGE"
docker run -d \
  --name "$CONTAINER" \
  --add-host "host.docker.internal:$BRIDGE_IP" \
  -v "$WORKTREE_VOLUME:/src" \
  "$IMAGE" sleep infinity >/dev/null

docker exec -u root "$CONTAINER" bash -c '
  set -e
  apt-get update -qq
  apt-get install -y -qq --no-install-recommends \
    git openssh-client ca-certificates curl jq >/dev/null
  useradd -u 1000 -m -d /home/agent -s /bin/bash agent
  install -d -o agent -g agent -m 0700 /home/agent/.ssh
  chown agent:agent /src
'

docker exec -u root -e STRIP="${PROVIDER_ENV_NAMES:-}" "$CONTAINER" bash -c '
  {
    echo "#!/bin/sh"
    printf "exec env"
    for name in $STRIP; do printf " -u %s" "$name"; done
    echo " /bin/bash \"\$@\""
  } > /usr/local/bin/qm-shell
  chmod 0755 /usr/local/bin/qm-shell
'
docker cp "$CLIENT_KEY" "$CONTAINER:$HOME_DIR/.ssh/gate"
docker exec -u root "$CONTAINER" chown agent:agent "$HOME_DIR/.ssh/gate"
docker exec -u root "$CONTAINER" chmod 600 "$HOME_DIR/.ssh/gate"

# The sandbox has git and little else. Anything more runs in one of the
# project's development environments, named on the command line, so both the
# agent and the log say where a command actually ran.
if [ "$(jq 'length' "$ENVIRONMENTS_JSON")" != 0 ]; then
  log "installing the development environment wrapper"
  docker exec -u root "$CONTAINER" bash -c "
    set -e
    cat > /usr/local/bin/dev <<'WRAP'
#!/bin/bash
# Run a command in one of this project's development environments.
set -euo pipefail
if [ \$# -lt 2 ]; then
  echo 'usage: dev <environment> <command>...' >&2
  exit 2
fi
name=\$1
shift
{ printf '%q ' \"\$@\"; printf '\n'; } > /tmp/dev.\$\$
exec ssh $SSH_OPTS $GATE_USER@host.docker.internal \"dev \$name\" < /tmp/dev.\$\$
WRAP
    chmod 0755 /usr/local/bin/dev
  "
fi

# Claude Code ships a native binary, so the sandbox needs no node runtime to
# run it, and neither installer needs root.
log "installing term-llm and claude"
as_agent "curl -fsSL https://raw.githubusercontent.com/samsaffron/term-llm/${TERM_LLM_VERSION}/install.sh | sh" &
term_llm_pid=$!
as_agent "curl -fsSL https://claude.ai/install.sh | bash" &
claude_pid=$!
wait $term_llm_pid
wait $claude_pid

log "cloning the branch"
as_agent "
  set -e
  git clone -q --depth 1 --branch "\$HEAD_REF" ssh://$GATE_USER@host.docker.internal/relay.git /src
  cd /src
  git config user.name  "$BOT_NAME"
  git config user.email "$BOT_NAME@users.noreply.github.com"
"

log "installing the agent"
docker exec -u root "$CONTAINER" install -d -o agent -g agent \
  "$HOME_DIR/.config/term-llm/agents" "$HOME_DIR/.config/term-llm/skills"
AGENT_TMP="$RUNNER_TEMP/agent"
rm -rf "$AGENT_TMP"
cp -r "$AGENT_DIR" "$AGENT_TMP"
if [ "$(jq 'length' "$ENVIRONMENTS_JSON")" != 0 ]; then
  {
    echo
    echo "## Development environments"
    echo
    echo "Commands needing more than git run in one of these:"
    echo
    jq -r 'to_entries[] | "    \(.key) — \(.value.description)"' "$ENVIRONMENTS_JSON"
    echo
    echo "Name the one you want:"
    echo
    jq -r 'to_entries[0] | "    dev \(.key) <command>"' "$ENVIRONMENTS_JSON"
    echo
    echo "Nothing runs in the sandbox itself, so a command on its own fails: there is no runtime for it there. Commands run at the environment's mount point."
    echo
    echo "The first command into an environment takes a few minutes while it starts; afterwards they are quick. Do not start one you have nothing to run in."
  } >> "$AGENT_TMP/system.md"
fi
docker cp "$AGENT_TMP/." "$CONTAINER:$HOME_DIR/.config/term-llm/agents/quartermaster"
docker cp "$SKILLS_DIR/." "$CONTAINER:$HOME_DIR/.config/term-llm/skills"
sed -e "s#__KEY__#$HOME_DIR/.ssh/gate#" \
    -e "s#__SSH_PORT__#$SSH_PORT#" \
    -e "s#__GATE_USER__#$GATE_USER#" \
    "$MCP_TEMPLATE" > "$RUNNER_TEMP/mcp.json"
docker cp "$RUNNER_TEMP/mcp.json" "$CONTAINER:$HOME_DIR/.config/term-llm/mcp.json"
if [ -n "${TERM_LLM_CONFIG:-}" ] && [ -s "$TERM_LLM_CONFIG" ]; then
  log "installing the project's term-llm configuration"
  docker cp "$TERM_LLM_CONFIG" "$CONTAINER:$HOME_DIR/.config/term-llm/config.yaml"
fi

docker exec -u root "$CONTAINER" chown -R agent:agent "$HOME_DIR/.config"

progress() { "${PROGRESS_SCRIPT:?}" "$@" || true; }

# Whatever the development environment does happens behind the gate, so its
# output goes to the sandbox and never here. Follow its log while the agent
# runs, or the runner shows nothing at all for the minutes it takes.
: > "$RUNNER_TEMP/dev-up.log"
tail -n +1 -F "$RUNNER_TEMP/dev-up.log" 2>/dev/null &
tail_pid=$!
trap 'kill "$tail_pid" 2>/dev/null || true' EXIT

progress next
log "running the agent"
docker cp "$RUNNER_TEMP/prompt.txt" "$CONTAINER:$HOME_DIR/prompt.txt"
set +e
as_agent "
  term-llm ask \
    --agent quartermaster \
    ${PROVIDER:+--provider "$PROVIDER"} \
    --session-db $HOME_DIR/session.db \
    --yolo \
    --text \
    --stats \
    --max-turns $MAX_TURNS \
    --timeout $AGENT_TIMEOUT \
    \"\$(cat $HOME_DIR/prompt.txt)\" 2>&1
" | sed -u -e 's/.*\r//'
status=${PIPESTATUS[0]}
set -e

docker cp "$CONTAINER:$HOME_DIR/finish.json"    "$RUNNER_TEMP/finish.json"      2>/dev/null || true
docker cp "$CONTAINER:$HOME_DIR/findings.jsonl" "$RUNNER_TEMP/findings.jsonl"   2>/dev/null || true

exit "$status"
