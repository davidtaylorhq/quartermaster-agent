#!/bin/bash
# Answer a follow-up in the sandbox that is already up.
#
# Everything the first turn built — the clone, the agent, any development
# environment — is still there, so this is the model's time and nothing else.
set -Eeuo pipefail

: "${RUNNER_TEMP:?}" "${SSH_PORT:?}"

CONTAINER=quartermaster_sandbox
HOME_DIR=/home/agent
SSH_OPTS="-i $HOME_DIR/.ssh/gate -p $SSH_PORT -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

log() { echo "[sandbox] $*" >&2; }

creds=()
if [ -n "${PROVIDER_ENV_FILE:-}" ] && [ -s "$PROVIDER_ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$PROVIDER_ENV_FILE"
  set +a
  for name in $PROVIDER_ENV_NAMES; do creds+=(-e "$name"); done
fi

# A turn may want the development environment too, and everything it does
# happens behind the gate where the runner sees none of it.
tail -n +1 -F "$RUNNER_TEMP/dev-up.log" 2>/dev/null &
trap 'kill "$!" 2>/dev/null || true' EXIT
progress() { "$(dirname "$0")/progress" "$@" || true; }

as_agent() {
  docker exec -i -u agent -w /src \
    -e HOME="$HOME_DIR" \
    -e GIT_SSH_COMMAND="ssh $SSH_OPTS" \
    -e SHELL=/usr/local/bin/qm-shell \
    "${creds[@]}" \
    "$CONTAINER" bash -lc 'export PATH="$HOME/.local/bin:$PATH"; '"$1"
}

# The reply and any line comments belong to this turn alone.
docker exec -u agent "$CONTAINER" rm -f "$HOME_DIR/finish.json" "$HOME_DIR/findings.jsonl" || true
rm -f "$RUNNER_TEMP/finish.json" "$RUNNER_TEMP/findings.jsonl"

log "answering the follow-up"
docker cp "$RUNNER_TEMP/prompt.txt" "$CONTAINER:$HOME_DIR/prompt.txt"
set +e
as_agent "
  term-llm ask \
    --agent quartermaster \
    ${PROVIDER:+--provider "$PROVIDER"} \
    --session-db $HOME_DIR/session.db \
    --resume \
    --yolo \
    --text \
    --stats \
    --max-turns $MAX_TURNS \
    --timeout $AGENT_TIMEOUT \
    \"\$(cat $HOME_DIR/prompt.txt)\" 2>&1
" | sed -u -e 's/.*\r//'
status=${PIPESTATUS[0]}
set -e

docker cp "$CONTAINER:$HOME_DIR/finish.json"    "$RUNNER_TEMP/finish.json"    2>/dev/null || true
docker cp "$CONTAINER:$HOME_DIR/findings.jsonl" "$RUNNER_TEMP/findings.jsonl" 2>/dev/null || true
exit "$status"
