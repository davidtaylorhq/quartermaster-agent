#!/usr/bin/env python3
"""Post everything the run produced, as one review, once.

The sandbox cannot reach GitHub. It leaves line comments in findings.jsonl and
its reply in finish.json, and this is the only thing that publishes either.
"""
import json
import os
import pathlib
import subprocess
import sys


# Every reply says where it came from and offers a way to say whether it helped.
# Line comments do not carry it: once per review is a footer, on each one it is
# noise.
FOOTER = (
    "<sub>:robot: AI generated response. "
    "Help us improve with a \U0001F44D or \U0001F44E reaction.</sub>"
)


def sign(body):
    body = redact(body).strip()
    return f"{body}\n\n{FOOTER}" if body else FOOTER


def read_findings(path):
    out = []
    for n, line in enumerate(pathlib.Path(path).read_text().splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        try:
            f = json.loads(line)
        except json.JSONDecodeError:
            print(f"ignoring unreadable line comment on line {n}", file=sys.stderr)
            continue
        if {"path", "line", "body"} <= f.keys():
            out.append({"path": f["path"], "line": f["line"], "side": "RIGHT",
                        "body": redact(f["body"])})
        else:
            print(f"ignoring incomplete line comment on line {n}", file=sys.stderr)
    return out


def gh(args, payload=""):
    # Always hand it a stdin, or a gh that reads one inherits ours and waits.
    p = subprocess.run(["gh", "api", *args], input=payload, capture_output=True, text=True)
    if p.returncode != 0:
        print(p.stderr.strip(), file=sys.stderr)
    return p.returncode == 0


def redact(text):
    """Take any credential back out of what is about to be published.

    The agent holds them so its provider can reach the model, and a reply is
    the one thing it writes that leaves the sandbox. Log masking does not
    reach a pull request comment.
    """
    path = os.environ.get("PROVIDER_ENV_FILE")
    if not text or not path or not os.path.exists(path):
        return text
    with open(path) as handle:
        for line in handle:
            _, _, value = line.partition("=")
            value = value.strip()
            if len(value) > 7:
                text = text.replace(value, "[redacted]")
    return text


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    issue = os.environ["ISSUE_NUMBER"]
    temp = pathlib.Path(os.environ["RUNNER_TEMP"])

    finish = temp / "finish.json"
    if not finish.exists():
        print("the agent never finished; nothing to post", file=sys.stderr)
        return 1
    reply = json.loads(finish.read_text()).get("reply", "").strip()

    findings_file = temp / "findings.jsonl"
    comments = read_findings(findings_file) if findings_file.exists() else []

    if not comments:
        if not reply:
            print("the agent finished with nothing to say", file=sys.stderr)
            return 0
        return 0 if gh([
            "--method", "POST", f"/repos/{repo}/issues/{issue}/comments",
            "-f", f"body={sign(reply)}",
        ]) else 1

    # A review carries the line comments and the reply together, so the author
    # gets one notification rather than one per point.
    payload = json.dumps({
        "commit_id": (temp / "relay.pushed").read_text().strip(),
        "event": "COMMENT",
        "body": sign(reply),
        "comments": comments,
    })
    print(f"posting {len(comments)} line comment(s)", file=sys.stderr)
    return 0 if gh(
        ["--method", "POST", f"/repos/{repo}/pulls/{issue}/reviews", "--input", "-"],
        payload,
    ) else 1


if __name__ == "__main__":
    sys.exit(main())
