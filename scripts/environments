#!/usr/bin/env ruby
# Read what the project says about its development environments and write what
# the rest of this reads: one JSON object, keyed by name.
#
# Anything wrong with the file stops the run here. A fault found later has
# already told somebody the bot is working on their comment.
require "yaml"
require "json"

src, dest = ARGV
KNOWN = %w[name description image entrypoint cmd user mount setup].freeze

if src.nil? || src.empty? || !File.exist?(src)
  File.write(dest, "{}")
  exit 0
end

doc = YAML.safe_load_file(src) || {}
list = doc["environments"]
abort "environments: expected a list under `environments`" unless list.is_a?(Array)

out = {}
list.each_with_index do |env, i|
  abort "environments: entry #{i + 1} is not a mapping" unless env.is_a?(Hash)

  name = env["name"].to_s
  abort "environments: entry #{i + 1} has no name" if name.empty?
  unless name.match?(/\A[A-Za-z0-9_-]+\z/)
    abort "environments: #{name.inspect} is not a name; use letters, digits, - and _"
  end
  abort "environments: two environments are called #{name.inspect}" if out.key?(name)

  %w[image mount].each do |field|
    abort "environments: #{name} has no #{field}" if env[field].to_s.empty?
  end
  (env.keys - KNOWN).each do |key|
    abort "environments: #{name} has an unknown setting #{key.inspect}"
  end

  out[name] = KNOWN.to_h { |field| [field, env[field].to_s] }
end

File.write(dest, JSON.pretty_generate(out))
