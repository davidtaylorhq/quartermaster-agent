#!/usr/bin/env python3
"""Find the mentions nobody has taken, and take them.

A run answers whatever is outstanding rather than the comment that happened to
start it. Runs on an issue are queued one at a time, and GitHub holds only one
in the queue: a third arrival displaces the second, whose comment then has
nothing looking for it. Answering oldest-first means the next run to start
picks it up, whichever comment started that run.

Everything already waiting is taken together and answered in one turn. People
correct themselves within seconds of asking, and answering the first comment
before reading the second means acting on an instruction that has already been
withdrawn.

Exits non-zero when there is nothing to answer.
"""
import datetime
import json
import os
import pathlib
import subprocess
import sys
import time

CLAIM = "eyes"
ALLOWED = set(os.environ.get("TRUSTED_ASSOCIATIONS", "OWNER,MEMBER,COLLABORATOR").split(","))
MACRO = os.environ["MENTION"]
# Old enough that nobody is still waiting for an answer. Anything further back
# is a backlog, and answering a backlog at once is worse than leaving it.
MAX_AGE_HOURS = int(os.environ.get("MAX_COMMENT_AGE_HOURS", "1"))
WINDOW = int(os.environ.get("FOLLOWUP_WINDOW", "60"))


def gh(args, quiet=False):
    p = subprocess.run(["gh", "api", *args], input="", capture_output=True, text=True)
    if p.returncode != 0 and not quiet:
        print(f"gh api {' '.join(args)}: {p.stderr.strip()}", file=sys.stderr)
    return p.stdout if p.returncode == 0 else ""


def comments(repo, issue, since):
    # Ask only for what could possibly be outstanding. Polling every few
    # seconds for every comment on a long thread is a lot of pages for an
    # answer that is almost always "nothing new".
    out = []
    for page in gh(["--paginate", f"repos/{repo}/issues/{issue}/comments?since={since}"]).splitlines():
        try:
            out.extend(json.loads(page))
        except json.JSONDecodeError:
            pass
    return out


def is_claimed(repo, comment):
    # The count comes with the comment. Nought means nobody has reacted at
    # all, which settles it without asking; anything else needs to know who.
    if not comment.get("reactions", {}).get(CLAIM):
        return False
    comment_id = comment["id"]
    for page in gh(["--paginate", f"repos/{repo}/issues/comments/{comment_id}/reactions"]).splitlines():
        try:
            for r in json.loads(page):
                if r.get("content") == CLAIM and r["user"]["login"].endswith("[bot]"):
                    return True
        except json.JSONDecodeError:
            pass
    return False


def claim(repo, comment_id):
    p = subprocess.run(
        ["gh", "api", "--method", "POST",
         f"/repos/{repo}/issues/comments/{comment_id}/reactions",
         "-f", f"content={CLAIM}"],
        input="", capture_output=True, text=True,
    )
    if p.returncode != 0:
        print(f"could not claim {comment_id}: {p.stderr.strip()}", file=sys.stderr)
        return False
    return True


def outstanding(repo, issue, cutoff):
    found = []
    for c in comments(repo, issue, cutoff):
        if c["created_at"] < cutoff:
            continue
        if c["user"]["login"].endswith("[bot]"):
            continue
        if c.get("author_association") not in ALLOWED:
            continue
        if MACRO not in (c.get("body") or ""):
            continue
        found.append(c)
    found.sort(key=lambda c: c["created_at"])
    return found


def take(repo, issue, cutoff, out):
    taken = []
    for c in outstanding(repo, issue, cutoff):
        if is_claimed(repo, c) or not claim(repo, c["id"]):
            continue
        taken.append({
            "id": c["id"], "author": c["user"]["login"],
            "body": c["body"], "created_at": c["created_at"],
        })
    if not taken:
        return False
    out.write_text(json.dumps(taken))
    who = ", ".join(str(c["id"]) for c in taken)
    print(f"answering {len(taken)} comment(s): {who}", file=sys.stderr)
    return True


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    issue = os.environ["ISSUE_NUMBER"]
    out = pathlib.Path(os.environ["MENTION_FILE"])
    wait = "--wait" in sys.argv

    cutoff = (
        datetime.datetime.now(datetime.timezone.utc)
        - datetime.timedelta(hours=MAX_AGE_HOURS)
    ).strftime("%Y-%m-%dT%H:%M:%SZ")

    deadline = time.time() + (WINDOW if wait else 0)
    while True:
        if take(repo, issue, cutoff, out):
            return 0
        if time.time() >= deadline:
            print("nothing outstanding", file=sys.stderr)
            return 1
        time.sleep(3)


if __name__ == "__main__":
    sys.exit(main())
