#!/usr/bin/env python3
"""Print what has already been said on this issue.

The agent has no memory between mentions and the thread is where the
conversation actually lives, so it goes in the prompt rather than depending on
the agent choosing to look it up.
"""
import json
import os
import subprocess
import sys

KEEP = 20
WIDTH = 800
# Anyone else can comment on a pull request. Their words belong in the record,
# but the agent should know whose words carry weight.
TRUSTED = set(os.environ.get("TRUSTED_ASSOCIATIONS", "OWNER,MEMBER,COLLABORATOR").split(","))

# The bot's own bookkeeping is not conversation. The checklist is recognised by
# how it opens, which is also what it is: a sentence saying work has started.
NOISE = ("Superseded by a newer mention.", "The run failed.", "Starting…", "On it!")
FOOTER_AT = "<sub>:robot:"


def comments(repo, issue):
    p = subprocess.run(
        ["gh", "api", "--paginate", f"repos/{repo}/issues/{issue}/comments"],
        input="", capture_output=True, text=True,
    )
    if p.returncode != 0:
        print(p.stderr.strip(), file=sys.stderr)
        return []
    out = []
    for page in p.stdout.strip().splitlines():
        try:
            out.extend(json.loads(page))
        except json.JSONDecodeError:
            pass
    return out


def useful(c):
    body = (c.get("body") or "").strip()
    return bool(body) and not body.startswith(NOISE)


def main():
    repo = os.environ["GITHUB_REPOSITORY"]
    issue = os.environ["ISSUE_NUMBER"]
    skip = set(os.environ.get("SKIP_COMMENT_IDS", "").split())

    kept = [c for c in comments(repo, issue) if useful(c) and str(c.get("id")) not in skip]
    if not kept:
        return 0

    dropped = len(kept) - KEEP
    if dropped > 0:
        print(f"({dropped} earlier comment(s) not shown; read them if you need them)\n")
        kept = kept[-KEEP:]

    for c in kept:
        body = c["body"].strip()
        # The signature is ours, not something anyone said.
        at = body.find(FOOTER_AT)
        if at != -1:
            body = body[:at].rstrip()
        if len(body) > WIDTH:
            body = body[:WIDTH] + " […]"
        who = c["user"]["login"]
        if who == os.environ.get("BOT_LOGIN", "github-actions[bot]"):
            who = "you"
        elif c.get("author_association") not in TRUSTED:
            who = f"{who} (cannot write to this repository)"
        print(f"@{who}:")
        print(body)
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
