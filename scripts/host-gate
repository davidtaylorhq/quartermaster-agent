#!/bin/sh
# The only thing the sandbox can ask the runner to do.
#
# Installed as a forced command in authorized_keys, so this runs whatever the
# client asked for. It matches on the verb and supplies its own arguments: the
# client's are discarded, which is what keeps this from being a parsing problem.
. "$HOME/.quartermaster/env"

case "$SSH_ORIGINAL_COMMAND" in
  mcp)
    exec docker run -i --rm \
      -e GITHUB_PERSONAL_ACCESS_TOKEN \
      -e GITHUB_TOOLSETS \
      -e GITHUB_READ_ONLY \
      "$MCP_IMAGE"
    ;;
  "dev "*)
    # The only verb that takes an argument. It is looked up in what the project
    # declared, never interpreted: a name nobody declared is refused here,
    # before it reaches docker or a shell.
    name=${SSH_ORIGINAL_COMMAND#dev }
    if ! jq -e --arg n "$name" 'has($n)' "$ENVIRONMENTS" >/dev/null 2>&1; then
      echo "$BOT_NAME: no environment called '$name'" >&2
      echo "$BOT_NAME: this project has: $(jq -r 'keys | join(", ")' "$ENVIRONMENTS")" >&2
      exit 1
    fi

    # Keep the boot off this connection's stdin: that is the command the agent
    # sent, and anything the environment starts would read it as input.
    "$HOME/.quartermaster/dev-boot" "$name" </dev/null || exit 1

    user=$(jq -r --arg n "$name" '.[$n].user // ""' "$ENVIRONMENTS")
    mount=$(jq -r --arg n "$name" '.[$n].mount' "$ENVIRONMENTS")
    if [ -n "$user" ]; then
      exec docker exec -i -u "$user" -w "$mount" -e CI=1 "quartermaster_dev_$name" bash -l
    fi
    exec docker exec -i -w "$mount" -e CI=1 "quartermaster_dev_$name" bash -l
    ;;
  git-upload-pack*)
    exec git-upload-pack "$RELAY"
    ;;
  git-receive-pack*)
    exec git-receive-pack "$RELAY"
    ;;
  *)
    echo "$BOT_NAME: not permitted" >&2
    exit 1
    ;;
esac
